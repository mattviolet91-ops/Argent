# Modèle pour le serveur o2switch (scripts/install.sh le remplit tout seul).
APP_NAME=Argent
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://argent.matts-couverture.fr

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Base SQLite rangée dans storage (jamais écrasée par les mises à jour).
DB_CONNECTION=sqlite
DB_DATABASE=/home/UTILISATEUR/argent/storage/argent.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database
MAIL_MAILER=log
